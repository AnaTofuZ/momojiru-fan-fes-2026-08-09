{
  "name": "momojiru-fan-fes-2026-08-09",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:ui": "vite",
    "build": "wrangler types && tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "db:local": "wrangler d1 migrations apply momojiru-memory --local",
    "db:remote": "wrangler d1 migrations apply momojiru-memory --remote"
  },
  "dependencies": {
    "hono": "^4.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.120.0"
  }
}
